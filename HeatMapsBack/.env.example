# Environment
NODE_ENV=development

# Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=sensor_data
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=your-kafka-server.com:28144
KAFKA_TOPIC=sensor-wifi-devices
KAFKA_GROUP_ID=grupo-sniffers

# SSL Certificates Paths (relative to project root)
KAFKA_SSL_CA_PATH=./certs/ca.pem
KAFKA_SSL_CERT_PATH=./certs/service.cert
KAFKA_SSL_KEY_PATH=./certs/service.key

# AES Encryption Keys (256-bit hex strings)
AES_KEY_1=your_32_byte_hex_key_here_64_characters_total
AES_KEY_2=your_32_byte_hex_key_here_64_characters_total

# WebSocket CORS (comma-separated origins, use * for all)
CORS_ORIGIN=*
